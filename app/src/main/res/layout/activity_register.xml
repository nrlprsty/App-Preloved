<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!--  Topbar  -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/colorTopbar"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Kembali"
                android:src="@drawable/ic_back"
                app:tint="@color/colorTopbarText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/fraunces_black"
                android:text="Buat Akun"
                android:textColor="@color/colorTopbarText"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>
        <!--  Form  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="37dp">
            <!--  Nama Lengkap  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fraunces_bold"
                android:text="Nama Lengkap"
                android:textColor="@color/textLabel"
                android:textSize="12sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etNama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field_edit"
                    android:fontFamily="@font/fraunces_regular"
                    android:hint="Nama lengkap kamu"
                    android:inputType="textPersonName"
                    android:paddingStart="36dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/textInput"
                    android:textColorHint="@color/textLabel"
                    android:textSize="14sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/errorNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/fraunces_regular"
                android:text=""
                android:textColor="#E53935"
                android:textSize="12sp"
                android:visibility="gone" />
            <!--  Email  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/fraunces_bold"
                android:text="Email"
                android:textColor="@color/textLabel"
                android:textSize="12sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field_edit"
                    android:fontFamily="@font/fraunces_regular"
                    android:hint="email@contoh.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="36dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/textInput"
                    android:textColorHint="@color/textLabel"
                    android:textSize="14sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/errorEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/fraunces_regular"
                android:text=""
                android:textColor="#E53935"
                android:textSize="12sp"
                android:visibility="gone" />
            <!--  Nomor HP  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/fraunces_bold"
                android:text="Nomor HP"
                android:textColor="@color/textLabel"
                android:textSize="12sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etHp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field_edit"
                    android:fontFamily="@font/fraunces_regular"
                    android:hint="8xx xxxx xxxx"
                    android:inputType="phone"
                    android:paddingStart="36dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/textInput"
                    android:textColorHint="@color/textLabel"
                    android:textSize="14sp" />
            </RelativeLayout>
            <!--  ERROR HP  -->
            <TextView
                android:id="@+id/errorHp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/fraunces_regular"
                android:text=""
                android:textColor="#E53935"
                android:textSize="12sp"
                android:visibility="gone" />
            <!--  Password  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/fraunces_bold"
                android:text="Password"
                android:textColor="@color/textLabel"
                android:textSize="12sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field_edit"
                    android:fontFamily="@font/fraunces_regular"
                    android:hint="Minimal 8 karakter"
                    android:inputType="textPassword"
                    android:paddingStart="36dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/textInput"
                    android:textColorHint="@color/textLabel"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tampilkan password"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/textLabel" />
            </RelativeLayout>

            <TextView
                android:id="@+id/errorPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/fraunces_regular"
                android:text=""
                android:textColor="#E53935"
                android:textSize="12sp"
                android:visibility="gone" />
            <!--  Konfirmasi Password  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/fraunces_bold"
                android:text="Konfirmasi Password"
                android:textColor="@color/textLabel"
                android:textSize="12sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etKonfirmasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field_edit"
                    android:fontFamily="@font/fraunces_regular"
                    android:hint="Ulangi password kamu"
                    android:inputType="textPassword"
                    android:paddingStart="36dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/textInput"
                    android:textColorHint="@color/textLabel"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnToggleKonfirmasi"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tampilkan konfirmasi password"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/textLabel" />
            </RelativeLayout>

            <TextView
                android:id="@+id/errorKonfirmasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/fraunces_regular"
                android:text=""
                android:textColor="#E53935"
                android:textSize="12sp"
                android:visibility="gone" />
            <!--  Tombol Daftar  -->
            <!--  Link Masuk  -->

            <Button
                android:id="@+id/btnDaftar"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="36dp"
                android:backgroundTint="@color/btnLightBg"
                android:fontFamily="@font/dmsans_bold"
                android:text="Daftar"
                android:textAllCaps="false"
                android:textColor="@color/btnLightText"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dmsans_regular"
                    android:text="Sudah punya akun? "
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/textBody"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtMasuk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dmsans_bold"
                    android:layout_gravity="center_horizontal"
                    android:text="Masuk"
                    android:textColor="@color/btnLightBg"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>