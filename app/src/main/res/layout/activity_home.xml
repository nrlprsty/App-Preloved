<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- HEADER (tidak ikut scroll) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorTopbar"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="40dp"
        android:paddingEnd="1dp"
        android:paddingBottom="14dp"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/btnDashboard"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="9dp"
                android:src="@drawable/ic_hamburger"
                app:tint="@color/colorTopbarText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:fontFamily="@font/fraunces_bold"
                android:text="Selamat datang,"
                android:textColor="@color/colorTopbarText"
                android:textSize="18sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvNamaUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fraunces_bold"
            android:text="User"
            android:textColor="@color/colorTopbarText"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/search_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/colorSecondary" />

            <EditText
                android:id="@+id/etCariProduk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/fraunces_regular"
                android:gravity="center_vertical"
                android:hint="Cari produk preloved..."
                android:inputType="text"
                android:maxLines="1"
                android:textColorHint="@color/textLabel"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- KONTEN YANG BISA DI-SCROLL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:fontFamily="@font/fraunces_bold"
            android:text="Produk"
            android:textColor="@color/textPrimary"
            android:textSize="18sp" />

        <!-- Empty state, tampil kalau belum ada produk sama sekali -->
        <TextView
            android:id="@+id/tvEmptyHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="Belum ada produk preloved.\nJadi yang pertama jualan!"
            android:textColor="@color/textLabel"
            android:textSize="14sp"
            android:fontFamily="@font/fraunces_regular"
            android:visibility="gone" />

        <!-- List produk dari Firestore, 2 kolom -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProdukHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- BOTTOM NAVIGATION (tidak ikut scroll) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/colorBottomNav"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- icon 1 -->
        <ImageView
            android:id="@+id/btnChat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_chat"
            app:tint="@color/colorBottomNavIcon"
            tools:ignore="DuplicateIds" />

        <!-- icon 2 -->
        <ImageView
            android:id="@+id/btnTambah"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/colorBottomNavIcon" />

        <!-- icon 3 -->
        <ImageView
            android:id="@+id/btnNotif"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_notif"
            app:tint="@color/colorBottomNavIcon"/>

        <!-- icon 4 -->
        <ImageView
            android:id="@+id/btnProduk"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_produk"
            app:tint="@color/colorBottomNavIcon"/>

    </LinearLayout>

</LinearLayout>