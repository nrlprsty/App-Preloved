<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Topbar Edit Profil -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorTopbar"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/fraunces_bold"
            android:text="Edit Profil"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Avatar + Ubah Foto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/circle_avatar_bg"
                        android:contentDescription="Avatar" />
                    <TextView
                        android:id="@+id/tv_avatar_edit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="U"
                        android:textColor="#C8614A"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/fraunces_bold"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_nama_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/fraunces_bold"
                    android:text="User"
                    android:textColor="#C8614A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="100dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#D9B5A8" />
            </LinearLayout>

            <!-- Input Fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fraunces_regular"
                    android:text="Nama Lengkap *"
                    android:textColor="#B08070"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_nama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_field_edit"
                    android:fontFamily="@font/fraunces_regular"
                    android:hint="Nama Lengkap"
                    android:inputType="textPersonName"
                    android:padding="10dp"
                    android:textColor="@color/textInput"
                    android:textColorHint="@color/textLabel"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/err_nama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/fraunces_regular"
                    android:textColor="@color/error"
                    android:textSize="11sp"
                    android:visibility="gone" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/fraunces_regular"
                    android:text="Nomor Telepon *"
                    android:textColor="#B08070"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_telepon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_field_edit"
                    android:fontFamily="@font/fraunces_regular"
                    android:hint="+62"
                    android:inputType="phone"
                    android:padding="10dp"
                    android:textColor="@color/textInput"
                    android:textColorHint="@color/textLabel"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/err_telepon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/fraunces_regular"
                    android:textColor="@color/error"
                    android:textSize="11sp"
                    android:visibility="gone" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/fraunces_regular"
                    android:text="Alamat *"
                    android:textColor="#B08070"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_alamat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_field_edit"
                    android:fontFamily="@font/fraunces_regular"
                    android:hint="Alamat"
                    android:inputType="textPostalAddress"
                    android:padding="10dp"
                    android:textColor="@color/textInput"
                    android:textColorHint="@color/textLabel"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/err_alamat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/fraunces_regular"
                    android:textColor="@color/error"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/fraunces_regular"
                    android:text="Email *"
                    android:textColor="#B08070"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_field_edit"
                    android:fontFamily="@font/fraunces_regular"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:padding="10dp"
                    android:textColor="@color/textInput"
                    android:textColorHint="@color/textLabel"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/err_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/fraunces_regular"
                    android:textColor="@color/error"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- Tombol Simpan -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_simpan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_btn_primary"
                    android:fontFamily="@font/fraunces_bold"
                    android:text="Simpan"
                    android:textColor="@color/btnLightText" />

                <!-- Tombol Batal -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_batal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_primary"
                    android:fontFamily="@font/fraunces_bold"
                    android:text="Batal"
                    android:textColor="@color/btnLightText" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>