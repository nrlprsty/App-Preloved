<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true">

    <!-- Topbar Edit Profil -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorTopbar"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Kembali"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Edit Profil"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/fraunces_bold"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Avatar + Ubah Foto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/circle_avatar_bg"
                        android:contentDescription="Avatar" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="U"
                        android:textColor="#C8614A"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/fraunces_bold"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="User"
                    android:textColor="#C8614A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fraunces_bold"/>

                <View
                    android:layout_width="100dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#D9B5A8" />
            </LinearLayout>

            <!-- Input Fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nama Lengkap *" android:textColor="#B08070" android:textSize="12sp" android:fontFamily="@font/fraunces_regular"/>
                <EditText android:id="@+id/et_nama"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:hint="Nama Lengkap"
                    android:background="@drawable/bg_field_edit"
                    android:padding="10dp" android:textSize="14sp"
                    android:inputType="textPersonName" android:fontFamily="@font/fraunces_regular"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Nomor Telepon *" android:textColor="#B08070" android:textSize="12sp" android:fontFamily="@font/fraunces_regular"/>
                <EditText android:id="@+id/et_telepon"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:hint="+62"
                    android:background="@drawable/bg_field_edit"
                    android:padding="10dp" android:textSize="14sp"
                    android:inputType="phone" android:fontFamily="@font/fraunces_regular"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Alamat *" android:textColor="#B08070" android:textSize="12sp" android:fontFamily="@font/fraunces_regular"/>
                <EditText android:id="@+id/et_alamat"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:hint="Alamat"
                    android:background="@drawable/bg_field_edit"
                    android:padding="10dp" android:textSize="14sp"
                    android:inputType="textPostalAddress" android:fontFamily="@font/fraunces_regular"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Email *" android:textColor="#B08070" android:textSize="12sp" android:fontFamily="@font/fraunces_regular"/>
                <EditText android:id="@+id/et_email"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:hint="Email"
                    android:background="@drawable/bg_field_edit"
                    android:padding="10dp" android:textSize="14sp"
                    android:inputType="textEmailAddress" android:fontFamily="@font/fraunces_regular"/>

                <!-- Tombol Simpan -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_simpan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:text="Simpan"
                    android:textColor="@color/btnLightText"
                    android:background="@drawable/bg_btn_primary"
                    android:fontFamily="@font/fraunces_bold"/>

                <!-- Tombol Batal -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_batal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Batal"
                    android:textColor="@color/btnLightText"
                    android:background="@drawable/bg_btn_primary"
                    android:fontFamily="@font/fraunces_bold"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>