<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/fraunces_black"
        android:text="Welcome To Preloved"
        android:textColor="@color/textOnDark"
        android:textSize="32sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_field_chart"
        android:padding="30dp"
        android:src="@drawable/cart_gelap" />

    <TextView
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/dmsans_regular"
        android:text="Jual dan beli barang bekas berkualitas mulai dari fashion hingga elektronik."
        android:textAlignment="center"
        android:textColor="@color/textOnDark" />

    <Button
        android:id="@+id/btnDaftar"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/btnDarkBg"
        android:fontFamily="@font/dmsans_extrabold"
        android:text="Daftar"
        android:textColor="@color/btnDarkText"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:backgroundTint="@color/btnDarkBg"
        android:fontFamily="@font/dmsans_extrabold"
        android:text="Login"
        android:textColor="@color/btnDarkText"
        android:textStyle="bold" />
</LinearLayout>