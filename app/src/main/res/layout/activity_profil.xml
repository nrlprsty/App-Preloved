<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true">

    <!-- Topbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorTopbar"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Kembali"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Profil"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/fraunces_bold"/>

        <TextView
            android:id="@+id/btn_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Edit"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/fraunces_bold"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </RelativeLayout>

    <!-- Banner sukses (awalnya GONE, muncul setelah simpan) -->
    <LinearLayout
        android:id="@+id/banner_sukses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_success_banner"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#C8614A"
            android:textSize="14sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Profil berhasil diperbarui"
            android:textColor="#C8614A"
            android:textSize="13sp"
            android:gravity="center"
            android:fontFamily="@font/fraunces_regular"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Avatar + Nama -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/circle_avatar_bg"
                        android:contentDescription="Avatar" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="U"
                        android:textColor="#C8614A"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/fraunces_regular"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_nama_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="User"
                    android:textColor="#C8614A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fraunces_bold"/>

                <View
                    android:layout_width="100dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#D9B5A8" />
            </LinearLayout>

            <!-- Fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nama Lengkap" android:textColor="#B08070" android:textSize="12sp" android:fontFamily="@font/fraunces_regular"/>
                <TextView android:id="@+id/tv_nama"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="User"
                    android:background="@drawable/bg_field_readonly"
                    android:padding="10dp" android:textSize="14sp" android:textColor="#333333" android:fontFamily="@font/fraunces_regular"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Nomor Telepon" android:textColor="#B08070" android:textSize="12sp" android:fontFamily="@font/fraunces_regular"/>
                <TextView android:id="@+id/tv_telepon"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="+62 1234567890"
                    android:background="@drawable/bg_field_readonly"
                    android:padding="10dp" android:textSize="14sp" android:textColor="#333333" android:fontFamily="@font/fraunces_regular"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Alamat" android:textColor="#B08070" android:textSize="12sp" android:fontFamily="@font/fraunces_regular"/>
                <TextView android:id="@+id/tv_alamat"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Jl. Merak 123"
                    android:background="@drawable/bg_field_readonly"
                    android:padding="10dp" android:textSize="14sp" android:textColor="#333333" android:fontFamily="@font/fraunces_regular"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Email" android:textColor="#B08070" android:textSize="12sp" android:fontFamily="@font/fraunces_regular"/>
                <TextView android:id="@+id/tv_email"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="user@gmail.com"
                    android:background="@drawable/bg_field_readonly"
                    android:padding="10dp" android:textSize="14sp" android:textColor="#333333" android:fontFamily="@font/fraunces_regular" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>